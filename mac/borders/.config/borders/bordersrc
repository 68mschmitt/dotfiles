#!/bin/bash
# JankyBorders config — highlights the focused window.
# Rainbow animates on AC power only (static on battery). Set RAINBOW=off to always be static.
RAINBOW=off

options=(
  style=round
  width=6.0
  hidpi=on
  active_color=0xff8aadf4         # solid theme accent (rainbow off)
  inactive_color=0x00000000      # no border on unfocused windows
)

if [ "$RAINBOW" = on ]; then
  "$HOME/.config/borders/rainbow.sh" &
fi

borders "${options[@]}"
