+
+// ── Synthesis chunking ─────────────────────────────────────────────
+//
+// Kokoro's transformer accepts at most 512 phoneme tokens per forward pass
+// (tokenizer_config.json: model_max_length = 512). kokoro-js tokenizes with
+// { truncation: true } and clamps the style index at 509, so text past ~510
+// tokens is dropped *silently*: the request still returns 200 and a valid WAV
+// that simply stops mid-thought (~23s at speed 1.25). Nothing warns. Long text
+// must therefore be split, synthesized piecewise, and concatenated.
+//
+// Phoneme count is only knowable after phonemization, which happens inside
+// kokoro-js and is not exported. So we estimate it from the source text with a
+// weighted character cost, calibrated by measuring where real synthesis
+// saturates. Measured cut-off points (fp32, af_heart, speed 1.0):
+//
+//   corpus           cliff (chars)   cost at cliff
+//   plain prose            450            450
+//   numeric dense          236            448
+//   acronym heavy          242            467
+//   mixed report           427            476   (held out)
+//   clipped punctuation    484            484   (held out)
+//
+// Raw character count is useless as a budget — the cliff moves by 2x between
+// prose and digit-dense text. The weighted cost holds within 1.08x across all
+// five corpora, including the two held-out ones, so it is a usable proxy.
+
+/** Characters that phonemize into whole words ("$" → "dollars"). */
+const SYMBOL_CHARS = new Set("$%&@#/*+=<>~^|".split(""));
+
+/**
+ * One character's contribution to the phoneme budget. Digits dominate
+ * ("0.0037" → "zero point zero zero three seven"), symbols become words, and
+ * letters inside an acronym get spelled out one phoneme group each ("TTS").
+ */
+function charCost(ch: string, prev: string, next: string): number {
+  if (ch >= "0" && ch <= "9") return 6;
+  if (SYMBOL_CHARS.has(ch)) return 7;
+  const upper = (c: string) => c >= "A" && c <= "Z";
+  if (upper(ch) && (upper(prev) || upper(next))) return 3;
+  return 1;
+}
+
+/** Estimated phoneme-token cost of `text` (see the calibration table above). */
+export function synthesisCost(text: string): number {
+  let total = 0;
+  for (let i = 0; i < text.length; i++) {
+    total += charCost(text[i] ?? "", text[i - 1] ?? "", text[i + 1] ?? "");
+  }
+  return total;
+}
+
+/**
+ * Per-chunk budget: 15% under the lowest measured cliff (448). Comfortably
+ * clears a length-compliant voice note (~55 words ≈ cost 330) in a single
+ * chunk, so ordinary notes keep their original one-call prosody.
+ */
+export const MAX_SYNTHESIS_COST = 380;
+
+/** Abbreviations whose trailing period never ends a sentence. */
+const ABBREVIATIONS = new Set([
+  "mr", "mrs", "ms", "dr", "prof", "sr", "jr", "st", "mt", "etc", "vs", "eg", "ie",
+  "inc", "ltd", "co", "dept", "fig", "no", "approx", "jan", "feb", "mar", "apr",
+  "jun", "jul", "aug", "sep", "sept", "oct", "nov", "dec",
+]);
+
+/** True if `unit` ends in an abbreviation or initial, so it is not a sentence end. */
+function endsWithAbbreviation(unit: string): boolean {
+  const m = /(\S+)\.$/.exec(unit);
+  if (!m) return false;
+  const word = (m[1] ?? "").replace(/^[^\w]+/, "");
+  if (word.length === 1) return true; // initial: "J."
+  if (/^(?:[A-Za-z]\.)+[A-Za-z]$/.test(word)) return true; // "e.g", "U.S"
+  return ABBREVIATIONS.has(word.toLowerCase());
+}
+
+/** Split one unbroken token (a long URL, a hash) to fit the budget. */
+function splitToken(token: string, maxCost: number): string[] {
+  const pieces: string[] = [];
+  let start = 0;
+  let running = 0;
+  for (let i = 0; i < token.length; i++) {
+    const c = charCost(token[i] ?? "", token[i - 1] ?? "", token[i + 1] ?? "");
+    if (running + c > maxCost && i > start) {
+      pieces.push(token.slice(start, i));
+      start = i;
+      running = 0;
+    }
+    running += c;
+  }
+  if (start < token.length) pieces.push(token.slice(start));
+  return pieces;
+}
+
+/**
+ * Split cleaned text into synthesis-sized chunks, preferring paragraph and
+ * sentence boundaries so seams land where a speaker would pause anyway.
+ *
+ * Guarantees, in priority order:
+ *   1. Every chunk fits the budget — nothing is silently truncated.
+ *   2. No text is lost: joining the chunks reproduces every word.
+ *   3. Text that already fits returns as a single chunk, so ordinary notes take
+ *      exactly the same path (one model call) as before this existed.
+ */
+export function splitForSynthesis(text: string, maxCost = MAX_SYNTHESIS_COST): string[] {
+  const trimmed = text.trim();
+  if (!trimmed) return [];
+  if (synthesisCost(trimmed) <= maxCost) return [trimmed];
+
+  // A unit is one sentence-ish span. `endsPara` marks a paragraph's last unit:
+  // packing across that boundary would run two paragraphs together inside one
+  // synthesis call and swallow the pause a speaker would take there.
+  interface Unit {
+    text: string;
+    endsPara: boolean;
+  }
+
+  // 1. Sentence-ish units, with paragraph breaks as hard boundaries.
+  const units: Unit[] = [];
+  for (const para of trimmed.split(/\n\s*\n+/)) {
+    const p = para.trim();
+    if (!p) continue;
+    const before = units.length;
+    let start = 0;
+    const re = /[.!?…](?=[\s"'’”)\]]|$)/g;
+    let m: RegExpExecArray | null;
+    while ((m = re.exec(p)) !== null) {
+      const end = m.index + 1;
+      const unit = p.slice(start, end).trim();
+      if (unit && !endsWithAbbreviation(unit)) {
+        units.push({ text: unit, endsPara: false });
+        start = end;
+      }
+    }
+    const tail = p.slice(start).trim();
+    if (tail) units.push({ text: tail, endsPara: false });
+    const last = units[units.length - 1];
+    if (last && units.length > before) last.endsPara = true;
+  }
+
+  // 2. Units still over budget are broken on word boundaries (and mid-token
+  //    only for a pathological unbroken run).
+  const sized: Unit[] = [];
+  for (const unit of units) {
+    if (synthesisCost(unit.text) <= maxCost) {
+      sized.push(unit);
+      continue;
+    }
+    const pieces: string[] = [];
+    let line = "";
+    for (const word of unit.text.split(/\s+/)) {
+      if (synthesisCost(word) > maxCost) {
+        if (line) {
+          pieces.push(line);
+          line = "";
+        }
+        pieces.push(...splitToken(word, maxCost));
+        continue;
+      }
+      const candidate = line ? `${line} ${word}` : word;
+      if (synthesisCost(candidate) > maxCost) {
+        if (line) pieces.push(line);
+        line = word;
+      } else {
+        line = candidate;
+      }
+    }
+    if (line) pieces.push(line);
+    pieces.forEach((piece, i) =>
+      sized.push({ text: piece, endsPara: unit.endsPara && i === pieces.length - 1 }),
+    );
+  }
+
+  // 3. Repack neighbours to make as few model calls as possible, stopping at
+  //    paragraph boundaries. Cost is recomputed per append: units are short and
+  //    a voice note is a few dozen of them, so the quadratic term is noise.
+  const chunks: string[] = [];
+  let current = "";
+  for (const unit of sized) {
+    const candidate = current ? `${current} ${unit.text}` : unit.text;
+    if (synthesisCost(candidate) > maxCost) {
+      if (current) chunks.push(current);
+      current = unit.text;
+    } else {
+      current = candidate;
+    }
+    if (unit.endsPara) {
+      chunks.push(current);
+      current = "";
+    }
+  }
+  if (current) chunks.push(current);
+
+  return chunks;
+}
