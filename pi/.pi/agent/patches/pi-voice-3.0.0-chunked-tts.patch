+/** Concatenate per-chunk sample buffers, padding the seams with brief silence. */
+function concatSamples(parts: Float32Array[], sampleRate: number): Float32Array {
+  if (parts.length === 0) return new Float32Array(0);
+  if (parts.length === 1) return parts[0] as Float32Array;
