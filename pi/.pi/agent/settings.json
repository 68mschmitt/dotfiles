{
  "lastChangelogVersion": "0.84.1",
  "defaultThinkingLevel": "max",
  "defaultProvider": "anthropic",
  "theme": "dark",
  "expertPanel": {
    "provider": "anthropic",
    "model": "claude-opus-4-6",
    "temperature": 0.7,
    "thinking": "max"
  },
  "packages": [
    "npm:pi-powerline-footer",
    "npm:pi-subagents"
  ],
  "powerline": {
    "preset": "default",
    "cost": {
      "subscriptionDisplay": "both"
    },
    "customItems": [
      {
        "id": "claudeUsage",
        "statusKey": "claude-usage",
        "position": "right",
        "hideWhenMissing": true
      },
      {
        "id": "openaiUsage",
        "statusKey": "openai-usage",
        "position": "right",
        "hideWhenMissing": true
      }
    ]
  },
  "hideThinkingBlock": false,
  "defaultModel": "claude-opus-5",
  "subagents": {
    "defaultModel": "anthropic/claude-sonnet-5",
    "agentOverrides": {
      "scout": {
        "model": "anthropic/claude-haiku-4-5",
        "thinking": "low"
      },
      "researcher": {
        "model": "anthropic/claude-sonnet-5",
        "thinking": "medium"
      },
      "context-builder": {
        "model": "anthropic/claude-sonnet-5",
        "thinking": "medium"
      },
      "worker": {
        "model": "anthropic/claude-sonnet-5",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "anthropic/claude-sonnet-5",
        "thinking": "medium"
      },
      "delegate": {
        "model": "anthropic/claude-sonnet-5",
        "thinking": "medium"
      },
      "planner": {
        "model": "anthropic/claude-opus-5",
        "thinking": "high"
      },
      "oracle": {
        "model": "anthropic/claude-opus-5",
        "thinking": "high"
      }
    }
  },
  "warnings": {
    "anthropicExtraUsage": false
  },
  "httpIdleTimeoutMs": 60000,
  "terminal": {
    "showTerminalProgress": true
  }
}