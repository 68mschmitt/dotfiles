{
  "lastChangelogVersion": "0.83.0",
  "defaultThinkingLevel": "high",
  "defaultProvider": "anthropic",
  "theme": "dark",
  "expertPanel": {
    "provider": "anthropic",
    "model": "claude-opus-4-6",
    "temperature": 0.7,
    "thinking": "max"
  },
  "packages": [
    "npm:pi-powerline-footer",
    "npm:pi-subagents",
    "npm:@s1m0n38/pi-voice"
  ],
  "powerline": {
    "preset": "default",
    "cost": {
      "subscriptionDisplay": "both"
    },
    "customItems": [
      {
        "id": "claudeUsage",
        "statusKey": "claude-usage",
        "position": "right",
        "hideWhenMissing": true
      },
      {
        "id": "openaiUsage",
        "statusKey": "openai-usage",
        "position": "right",
        "hideWhenMissing": true
      }
    ]
  },
  "hideThinkingBlock": false,
  "defaultModel": "claude-opus-5",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "httpIdleTimeoutMs": 60000,
  "terminal": {
    "showTerminalProgress": true
  }
}