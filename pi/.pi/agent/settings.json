{
  "lastChangelogVersion": "0.80.10",
  "defaultThinkingLevel": "xhigh",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-4-8",
  "theme": "dark",
  "expertPanel": {
    "provider": "anthropic",
    "model": "claude-opus-4-6",
    "temperature": 0.7,
    "thinking": "max"
  },
  "packages": [
    "npm:pi-powerline-footer"
  ],
  "workingVibe": "firefly tv show",
  "powerline": {
    "preset": "default",
    "cost": {
      "subscriptionDisplay": "both"
    },
    "customItems": [
      {
        "id": "claudeUsage",
        "statusKey": "claude-usage",
        "position": "right",
        "hideWhenMissing": true
      },
      {
        "id": "openaiUsage",
        "statusKey": "openai-usage",
        "position": "right",
        "hideWhenMissing": true
      }
    ]
  },
  "showHardwareCursor": true,
  "hideThinkingBlock": false,
  "tmuxSubagent": {
    "defaultTransport": "hidden"
  }
}
